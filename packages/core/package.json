{
  "name": "@sentinal/ai-agent-sdk",
  "version": "1.0.0",
  "description": "Production-ready AI Agent SDK for Cronos EVM",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:payments": "jest src/payments/__tests__/",
    "test:x402": "jest --testNamePattern='x402|402|payment'",
    "test:debug": "jest --verbose --no-cache",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cronos",
    "ai",
    "agent",
    "blockchain",
    "evm"
  ],
  "dependencies": {
    "ethers": "^6.9.2",
    "openai": "^4.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
