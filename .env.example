# Cronos AI Agent SDK Configuration

# ==============================================
# Docker Deployment Configuration
# ==============================================

# Port Configuration
SIMPLEVAULT_PORT=3000
UI_DEMO_PORT=3001
COMMERCIAL_DEMO_PORT=3002

# ==============================================
# SimpleVault Landing v1 Configuration
# ==============================================

# Network Configuration
VITE_NETWORK=cronos-testnet
VITE_RPC_URL=https://evm-t3.cronos.org

# Contract Configuration
VITE_CONTRACT_ADDRESS=0x656a4D09f53ab82f6B291082cb3159F7c14424dE
VITE_CONTRACT_NETWORK=cronos-testnet

# Application Configuration
VITE_LOG_LEVEL=INFO
VITE_APP_NAME=SimpleVault Landing
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# ==============================================
# SDK Core Configuration
# ==============================================

# Required: Private key for agent transactions
AGENT_PRIVATE_KEY=your_private_key_here

# Optional: OpenAI API key for AI-powered agents
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom RPC URLs
CRONOS_MAINNET_RPC=https://evm.cronos.org
CRONOS_TESTNET_RPC=https://evm-t3.cronos.org

# ==============================================
# Contract Addresses
# ==============================================

# SimpleVault Contract
SIMPLE_VAULT_ADDRESS=0x656a4D09f53ab82f6B291082cb3159F7c14424dE

# Optional: Other contract addresses for examples
VAULT_CONTRACT_ADDRESS=0x123...
DEX_CONTRACT_ADDRESS=0x456...

# ==============================================
# Optional: x402 Payment Configuration
# ==============================================

X402_PAYMENT_ENDPOINT=https://your-payment-server.com
X402_API_KEY=your_x402_api_key
