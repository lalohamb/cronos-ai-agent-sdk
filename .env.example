# Cronos AI Agent SDK Configuration

# Required: Private key for agent transactions
AGENT_PRIVATE_KEY=your_private_key_here

# Optional: OpenAI API key for AI-powered agents
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom RPC URLs
CRONOS_MAINNET_RPC=https://evm.cronos.org
CRONOS_TESTNET_RPC=https://evm-t3.cronos.org

# Optional: Contract addresses for examples
VAULT_CONTRACT_ADDRESS=0x123...
DEX_CONTRACT_ADDRESS=0x456...

# Optional: x402 Payment configuration
X402_PAYMENT_ENDPOINT=https://your-payment-server.com
X402_API_KEY=your_x402_api_key

SIMPLE_VAULT_ADDRESS=0xe30093CF82Cb6bc4176a2e1F60B66DFb02811E8a
